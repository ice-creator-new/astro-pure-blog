---
import PageLayout from '@/layouts/BaseLayout.astro'

import { Button, CardList } from '@/components/user'
import { cn } from '@/utils'
import { integrationConfig } from '@/site-config'

import { docs } from './contents'

export const prerender = true

const meta = {
  title: '文档',
  description: '主题文档'
}
---

<PageLayout {meta}>
  <div class='w-full'>
    <Button title='返回' data-i18n='common.back' href='/' style='back' />
    <h1 id='content-header' class='animate mb-6 mt-6 text-3xl font-medium sm:mt-10'>
      <span data-i18n='docs.heading'>Astro Theme Pure 文档</span>
    </h1>

    <div
      id='content'
      class={cn('animate mt-8 max-w-none md:min-w-[45ch]', integrationConfig.typography.class)}
    >
      <h2 class='text-xl font-medium' data-i18n='docs.themeDoc'>主题文档</h2>
      <CardList {...docs} />

      <h2 class='text-xl font-medium' data-i18n='docs.feedback'>反馈</h2>
      <p data-i18n='docs.feedbackBody'>
        如有问题，可到 <a
          href='https://github.com/cworld1/astro-theme-pure/issues'
          target='_blank'>Github Issues</a
        > 寻求社区支持。
      </p>
    </div>
  </div>
</PageLayout>
