---
import PageLayout from '@/layouts/CommonPage.astro'
import { Image } from 'astro:assets'

import ProjectSection from '@/components/projects/ProjectSection.astro'

const GITHUB_USER = 'ice-creator-new'

const headings = [
  { depth: 2, slug: 'repos', text: 'GitHub' },
]

type GhRepo = {
  name: string
  description: string | null
  html_url: string
  homepage: string | null
  fork: boolean
  archived: boolean
  pushed_at: string
}

let projects: {
  name: string
  description: string
  links: { type: string; href: string }[]
}[] = []
let fetchError = ''

try {
  const headers: Record<string, string> = {
    Accept: 'application/vnd.github+json',
    'User-Agent': 'astro-pure-blog',
  }
  const token = import.meta.env.GITHUB_TOKEN || process.env.GITHUB_TOKEN
  if (token) headers.Authorization = `Bearer ${token}`

  const res = await fetch(
    `https://api.github.com/users/${GITHUB_USER}/repos?sort=updated&per_page=100&type=owner`,
    { headers }
  )
  if (!res.ok) {
    throw new Error(`GitHub API ${res.status}`)
  }
  const repos = (await res.json()) as GhRepo[]
  projects = repos
    .filter((r) => !r.fork && !r.archived)
    .map((r) => {
      const links: { type: string; href: string }[] = [
        { type: 'github', href: r.html_url },
      ]
      const home = (r.homepage || '').trim()
      if (home) {
        const href = home.startsWith('http') ? home : `https://${home}`
        links.push({ type: 'site', href })
      }
      return {
        name: r.name,
        description: r.description || '（无描述）',
        links,
      }
    })
} catch (e) {
  fetchError = e instanceof Error ? e.message : String(e)
}
---

<PageLayout title='项目' {headings} info={{ slug: '/projects', hideComment: true }}>
  <p data-i18n='projects.intro'>以下列表每次打开页面时从 GitHub 实时拉取公开仓库。</p>
  <p>
    <Image
      src={`https://ghchart.rshah.org/659eb9/${GITHUB_USER}`}
      alt='github activities'
      inferSize
      loading='lazy'
    />
  </p>

  <h2 id='repos' data-i18n='projects.repos'>仓库</h2>
  {
    fetchError ? (
      <p class='text-muted-foreground'>暂时无法拉取仓库：{fetchError}</p>
    ) : projects.length === 0 ? (
      <p class='text-muted-foreground' data-i18n='projects.empty'>暂无公开仓库。</p>
    ) : (
      <ProjectSection project={projects} />
    )
  }
</PageLayout>
