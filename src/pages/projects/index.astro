---
import PageLayout from '@/layouts/CommonPage.astro'
import { Image } from 'astro:assets'

import ProjectSection from '@/components/projects/ProjectSection.astro'

const headings = [
  { depth: 2, slug: 'repos', text: 'GitHub' },
]

const projects = [
  {
    name: 'astro-pure-blog',
    description: '个人中文博客（Astro Theme Pure），支持中英切换，部署在 Vercel。',
    links: [
      { type: 'github', href: 'https://github.com/ice-creator-new/astro-pure-blog' },
      { type: 'site', href: 'https://astro-pure-blog.vercel.app' },
    ],
  },
  {
    name: 'ice-creator-new.github.io',
    description: '个人主页 — GSAP ScrollTrigger 视差效果。',
    links: [
      { type: 'github', href: 'https://github.com/ice-creator-new/ice-creator-new.github.io' },
      { type: 'site', href: 'https://ice-creator-new.github.io' },
    ],
  },
]
---

<PageLayout title='项目' {headings} info={{ slug: '/projects', hideComment: true }}>
  <p data-i18n='projects.intro'>以下项目与我的 GitHub 仓库同步。</p>
  <p>
    <Image
      src='https://ghchart.rshah.org/659eb9/ice-creator-new'
      alt='github activities'
      inferSize
      loading='lazy'
    />
  </p>

  <h2 id='repos' data-i18n='projects.repos'>仓库</h2>
  <ProjectSection project={projects} />
</PageLayout>
