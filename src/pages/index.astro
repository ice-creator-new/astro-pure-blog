---
import PageLayout from '@/layouts/BaseLayout.astro'
import { Image } from 'astro:assets'

import { Quote } from '@/components/advanced'
import PostPreview from '@/components/blog/PostPreview.astro'
import Section from '@/components/home/Section.astro'
import SkillLayout from '@/components/home/SkillLayout.astro'
import { Button, Label } from '@/components/user'
import { getAllCollections, sortMDByDate } from '@/utils'
import avatar from '@/assets/avatar.png'
import { siteConfig } from '@/site-config'

const languages = ['Html', 'JavaScript', 'CSS', 'Shell']
const frontend = ['TypeScript', 'Vite', 'Webpack', 'Astro']
const backend = ['Vercel', 'Waline']

const MAX_POSTS = 10
const allPosts = await getAllCollections()
const allPostsByDate = sortMDByDate(allPosts).slice(0, MAX_POSTS)
---

<PageLayout meta={{ title: '首页' }} highlightColor='#659EB966'>
  <div class='flex w-full flex-col items-center'>
    <section class='animate mb-10 flex flex-col items-center gap-y-7' id='content-header'>
      <Image
        src={avatar}
        alt='profile'
        class='h-28 w-auto rounded-full border p-1'
        loading='eager'
      />

      <div class='flex flex-col items-center gap-y-4'>
        <h1 class='text-3xl font-bold'>{siteConfig.author}</h1>
        <div class='flex flex-wrap justify-center gap-x-7 gap-y-3'>
          <Label title='中国' data-i18n='home.location'>
            <svg class='size-5' slot='icon'>
              <use href='/icons/social.svg#mingcute-location-line'></use>
            </svg>
          </Label>
          <Label
            title='源码'
            data-i18n='home.source'
            as='a'
            href='https://github.com/ice-creator-new/astro-pure-blog'
            target='_blank'
          >
            <svg class='size-5' slot='icon'>
              <use href='/icons/social.svg#mingcute-github-line'></use>
            </svg>
          </Label>
        </div>
      </div>

      {/* Get template */}
      <a
        href='https://github.com/ice-creator-new'
        target='_blank'
        class='flex flex-row items-center gap-x-3 rounded-full border border-border px-4 py-2 text-sm shadow-sm transition-shadow hover:shadow-md'
      >
        <span class='relative flex items-center justify-center'>
          <span
            class='absolute size-2 animate-ping rounded-full border border-green-400 bg-green-400 opacity-75'
          ></span>
          <span class='size-2 rounded-full bg-green-400'></span>
        </span>
        <p class='font-medium text-muted-foreground' data-i18n='home.github'>GitHub</p>
      </a>
    </section>

    <div id='content' class='flex flex-col gap-y-10 md:w-4/5 lg:w-5/6'>
      <Section title='关于' data-i18n-title='home.about'>
        <p class='text-muted-foreground' data-i18n='home.about.role'>开发者 / 设计师</p>
        <p class='text-muted-foreground' data-i18n='home.about.body'>
          我是 ice。这里会写项目笔记和一些想法。
        </p>
        <Button title='了解更多' data-i18n='home.about.more' class='w-fit self-end' href='/about' style='ahead' />
      </Section>
      {
        allPostsByDate.length > 0 && (
          <Section title='最新文章' data-i18n-title='home.posts'>
            <ul class='flex flex-col gap-y-1.5 sm:gap-y-2'>
              {allPostsByDate.map((p) => (
                <li class='flex flex-col gap-x-2 sm:flex-row'>
                  <PostPreview post={p} />
                </li>
              ))}
            </ul>
            <Button title='更多文章' data-i18n='home.posts.more' class='w-fit self-end' href='/blog' style='ahead' />
          </Section>
        )
      }

      <Section title='技能' data-i18n-title='home.skills'>
        <SkillLayout title='语言' data-i18n-title='home.skills.languages' skills={languages} />
        <SkillLayout title='前端' data-i18n-title='home.skills.frontend' skills={frontend} />
        <SkillLayout title='后端' data-i18n-title='home.skills.backend' skills={backend} />
      </Section>
    </div>
  </div>

  <Quote class='mt-12' />
</PageLayout>
