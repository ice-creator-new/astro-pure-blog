---
import PageLayout from '@/layouts/BaseLayout.astro'

export const prerender = false
---

<PageLayout meta={{ title: '作者后台', description: '博客作者管理', robots: 'noindex, nofollow' }}>
  <div class='mx-auto w-full max-w-3xl px-4 py-10' id='author-app'>
    <section id='view-login' class='animate flex flex-col items-center gap-6'>
      <div class='w-full max-w-sm rounded-2xl border border-border bg-muted/40 p-6 shadow-sm'>
        <h1 class='mb-1 text-2xl font-bold'>作者后台</h1>
        <p class='mb-6 text-sm text-muted-foreground'>
          输入作者密码以管理文章。保存后会写入 GitHub 并触发重新部署。
        </p>
        <form id='login-form' class='flex flex-col gap-3'>
          <label class='text-sm font-medium' for='password'>密码</label>
          <input
            id='password'
            name='password'
            type='password'
            autocomplete='current-password'
            class='rounded-lg border border-border bg-background px-3 py-2 text-sm outline-none focus:border-foreground/40'
            required
          />
          <p id='login-error' class='hidden text-sm text-red-500'></p>
          <button
            type='submit'
            class='mt-2 rounded-lg border border-border bg-background px-3 py-2 text-sm font-medium transition hover:bg-primary-foreground'
          >
            进入
          </button>
        </form>
      </div>
    </section>

    <section id='view-dash' class='hidden animate flex-col gap-8'>
      <header class='flex flex-wrap items-center justify-between gap-3'>
        <div>
          <h1 class='text-2xl font-bold'>文章管理</h1>
          <p class='text-sm text-muted-foreground' id='github-hint'>加载中…</p>
        </div>
        <div class='flex gap-2'>
          <button
            id='btn-new'
            type='button'
            class='rounded-lg border border-border bg-background px-3 py-1.5 text-sm transition hover:bg-primary-foreground'
          >
            新建文章
          </button>
          <button
            id='btn-logout'
            type='button'
            class='rounded-lg border border-border px-3 py-1.5 text-sm text-muted-foreground transition hover:bg-muted'
          >
            退出
          </button>
        </div>
      </header>

      <div id='status' class='hidden rounded-lg border border-border bg-muted/50 px-3 py-2 text-sm'></div>
      <ul id='post-list' class='flex flex-col gap-2'></ul>

      <div id='editor' class='hidden rounded-2xl border border-border bg-muted/30 p-5'>
        <div class='mb-4 flex items-center justify-between'>
          <h2 class='text-lg font-semibold' id='editor-title'>编辑</h2>
          <button id='btn-cancel' type='button' class='text-sm text-muted-foreground hover:text-foreground'>
            关闭
          </button>
        </div>
        <form id='editor-form' class='flex flex-col gap-3'>
          <input type='hidden' id='edit-mode' value='create' />
          <div class='grid gap-3 sm:grid-cols-2'>
            <div class='flex flex-col gap-1'>
              <label class='text-xs text-muted-foreground' for='f-slug'>Slug（URL）</label>
              <input id='f-slug' class='field' placeholder='my-post' />
            </div>
            <div class='flex flex-col gap-1'>
              <label class='text-xs text-muted-foreground' for='f-date'>发布日期</label>
              <input id='f-date' class='field' placeholder='2026-09-14 20:00:00' />
            </div>
          </div>
          <div class='flex flex-col gap-1'>
            <label class='text-xs text-muted-foreground' for='f-title'>标题</label>
            <input id='f-title' class='field' required maxlength='60' />
          </div>
          <div class='flex flex-col gap-1'>
            <label class='text-xs text-muted-foreground' for='f-titleEn'>英文标题（可选）</label>
            <input id='f-titleEn' class='field' maxlength='80' />
          </div>
          <div class='flex flex-col gap-1'>
            <label class='text-xs text-muted-foreground' for='f-desc'>摘要（≥10 字）</label>
            <input id='f-desc' class='field' required maxlength='180' />
          </div>
          <div class='flex flex-col gap-1'>
            <label class='text-xs text-muted-foreground' for='f-descEn'>英文摘要（可选）</label>
            <input id='f-descEn' class='field' maxlength='180' />
          </div>
          <div class='grid gap-3 sm:grid-cols-2'>
            <div class='flex flex-col gap-1'>
              <label class='text-xs text-muted-foreground' for='f-tags'>标签（逗号分隔）</label>
              <input id='f-tags' class='field' placeholder='AI, 评测' />
            </div>
            <div class='flex flex-col gap-1'>
              <label class='text-xs text-muted-foreground' for='f-lang'>语言标记</label>
              <input id='f-lang' class='field' value='中 / EN' />
            </div>
          </div>
          <label class='flex items-center gap-2 text-sm text-muted-foreground'>
            <input id='f-draft' type='checkbox' class='rounded border-border' />
            草稿（draft）
          </label>
          <div class='flex flex-col gap-1'>
            <label class='text-xs text-muted-foreground' for='f-body'>正文（Markdown）</label>
            <textarea
              id='f-body'
              class='field min-h-[280px] font-mono text-xs leading-relaxed'
              spellcheck='false'></textarea>
          </div>
          <div class='mt-2 flex flex-wrap gap-2'>
            <button
              type='submit'
              class='rounded-lg border border-border bg-background px-4 py-2 text-sm font-medium hover:bg-primary-foreground'
            >
              保存到 GitHub
            </button>
            <a
              id='btn-preview'
              href='#'
              target='_blank'
              rel='noopener'
              class='rounded-lg border border-border px-4 py-2 text-sm text-muted-foreground hover:bg-muted'
            >
              查看线上
            </a>
          </div>
          <p class='text-xs text-muted-foreground'>
            保存会提交到仓库并通常触发 Vercel 重建（约 1–3 分钟）。配图请用仓库内路径；本页暂不上传二进制。
          </p>
        </form>
      </div>
    </section>
  </div>
</PageLayout>

<style>
  #author-app .field {
    border-radius: 0.5rem;
    border: 1px solid hsl(var(--border));
    background: hsl(var(--background));
    padding: 0.5rem 0.75rem;
    font-size: 0.875rem;
    outline: none;
  }
  #author-app .field:focus {
    border-color: hsl(var(--foreground) / 0.4);
  }
  #post-list li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    border-radius: 0.75rem;
    border: 1px solid hsl(var(--border));
    background: hsl(var(--muted) / 0.35);
    padding: 0.75rem 1rem;
  }
</style>

<script is:inline>
  const $ = (id) => document.getElementById(id)
  const loginView = $('view-login')
  const dashView = $('view-dash')
  const statusEl = $('status')
  const listEl = $('post-list')
  const editor = $('editor')

  function showStatus(msg, isError) {
    statusEl.textContent = msg
    statusEl.classList.remove('hidden')
    statusEl.style.color = isError ? '#ef4444' : ''
  }
  function hideStatus() {
    statusEl.classList.add('hidden')
  }

  async function api(url, opts = {}) {
    const res = await fetch(url, {
      credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json', ...(opts.headers || {}) },
      ...opts
    })
    let data = null
    try {
      data = await res.json()
    } catch (_) {}
    if (!res.ok) throw new Error((data && data.error) || res.statusText)
    return data
  }

  function showLogin() {
    loginView.classList.remove('hidden')
    dashView.classList.add('hidden')
    dashView.classList.remove('flex')
  }
  function showDash() {
    loginView.classList.add('hidden')
    dashView.classList.remove('hidden')
    dashView.classList.add('flex')
  }

  function escapeHtml(s) {
    return String(s)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
  }

  async function loadPosts() {
    hideStatus()
    const data = await api('/api/author/posts')
    listEl.innerHTML = ''
    if (!data.posts.length) {
      listEl.innerHTML = '<li class="text-sm text-muted-foreground">还没有文章。</li>'
      return
    }
    for (const p of data.posts) {
      const li = document.createElement('li')
      li.innerHTML =
        '<div><p class="font-medium">' +
        escapeHtml(p.title) +
        '</p><p class="text-xs text-muted-foreground">' +
        escapeHtml(p.slug) +
        ' · ' +
        escapeHtml(String(p.publishDate)) +
        (p.draft ? ' · 草稿' : '') +
        '</p></div><div class="flex gap-2">' +
        '<button type="button" data-edit="' +
        escapeHtml(p.slug) +
        '" class="rounded-lg border border-border bg-background px-2.5 py-1 text-xs hover:bg-primary-foreground">编辑</button>' +
        '<button type="button" data-del="' +
        escapeHtml(p.slug) +
        '" class="rounded-lg border border-border px-2.5 py-1 text-xs text-red-500 hover:bg-muted">删除</button></div>'
      listEl.appendChild(li)
    }
    listEl.querySelectorAll('[data-edit]').forEach((btn) => {
      btn.addEventListener('click', () => openEdit(btn.getAttribute('data-edit')))
    })
    listEl.querySelectorAll('[data-del]').forEach((btn) => {
      btn.addEventListener('click', () => removePost(btn.getAttribute('data-del')))
    })
  }

  async function refreshSession() {
    const data = await api('/api/author/session')
    if (!data.ok) {
      showLogin()
      return false
    }
    showDash()
    $('github-hint').textContent = data.github
      ? '已连接 GitHub，保存将直接提交到仓库。'
      : '警告：未配置 AUTHOR_GITHUB_TOKEN，无法写入文章。'
    await loadPosts()
    return true
  }

  function openCreate() {
    $('edit-mode').value = 'create'
    $('editor-title').textContent = '新建文章'
    $('f-slug').disabled = false
    $('f-slug').value = ''
    $('f-title').value = ''
    $('f-titleEn').value = ''
    $('f-desc').value = ''
    $('f-descEn').value = ''
    $('f-tags').value = ''
    $('f-lang').value = '中 / EN'
    $('f-date').value = new Date().toISOString().slice(0, 16).replace('T', ' ') + ':00'
    $('f-draft').checked = false
    $('f-body').value = '<div data-post-lang="zh">

## 标题

正文

</div>

<div data-post-lang="en" hidden>

## Title

Body

</div>
'
    $('btn-preview').href = '#'
    editor.classList.remove('hidden')
    editor.scrollIntoView({ behavior: 'smooth', block: 'start' })
  }

  async function openEdit(slug) {
    showStatus('加载文章…')
    const data = await api('/api/author/posts/' + encodeURIComponent(slug))
    hideStatus()
    $('edit-mode').value = 'edit'
    $('editor-title').textContent = '编辑 · ' + slug
    $('f-slug').value = slug
    $('f-slug').disabled = true
    $('f-title').value = data.meta.title || ''
    $('f-titleEn').value = data.meta.titleEn || ''
    $('f-desc').value = data.meta.description || ''
    $('f-descEn').value = data.meta.descriptionEn || ''
    $('f-tags').value = (data.meta.tags || []).join(', ')
    $('f-lang').value = data.meta.language || '中 / EN'
    $('f-date').value = data.meta.publishDate || ''
    $('f-draft').checked = Boolean(data.meta.draft)
    $('f-body').value = data.body || ''
    $('btn-preview').href = '/blog/' + encodeURIComponent(slug)
    editor.classList.remove('hidden')
    editor.scrollIntoView({ behavior: 'smooth', block: 'start' })
  }

  async function removePost(slug) {
    if (!confirm('确定删除「' + slug + '」？会从 GitHub 删除该文章目录。')) return
    showStatus('删除中…')
    await api('/api/author/posts/' + encodeURIComponent(slug), { method: 'DELETE' })
    showStatus('已删除，等待重新部署后线上消失。')
    editor.classList.add('hidden')
    await loadPosts()
  }

  $('login-form').addEventListener('submit', async (e) => {
    e.preventDefault()
    const err = $('login-error')
    err.classList.add('hidden')
    try {
      await api('/api/author/login', {
        method: 'POST',
        body: JSON.stringify({ password: $('password').value })
      })
      await refreshSession()
    } catch (ex) {
      err.textContent = ex.message || '登录失败'
      err.classList.remove('hidden')
    }
  })

  $('btn-logout').addEventListener('click', async () => {
    await api('/api/author/logout', { method: 'POST', body: '{}' })
    showLogin()
  })
  $('btn-new').addEventListener('click', openCreate)
  $('btn-cancel').addEventListener('click', () => editor.classList.add('hidden'))

  $('editor-form').addEventListener('submit', async (e) => {
    e.preventDefault()
    const mode = $('edit-mode').value
    const slug = $('f-slug').value.trim()
    const payload = {
      slug,
      title: $('f-title').value.trim(),
      titleEn: $('f-titleEn').value.trim() || undefined,
      description: $('f-desc').value.trim(),
      descriptionEn: $('f-descEn').value.trim() || undefined,
      publishDate: $('f-date').value.trim(),
      tags: $('f-tags').value,
      language: $('f-lang').value.trim(),
      draft: $('f-draft').checked,
      body: $('f-body').value
    }
    try {
      showStatus(mode === 'create' ? '创建中…' : '保存中…')
      if (mode === 'create') {
        const res = await api('/api/author/posts', { method: 'POST', body: JSON.stringify(payload) })
        showStatus('已创建 ' + res.slug + '，部署后见 /blog/' + res.slug)
        $('edit-mode').value = 'edit'
        $('f-slug').disabled = true
        $('f-slug').value = res.slug
        $('btn-preview').href = '/blog/' + encodeURIComponent(res.slug)
      } else {
        await api('/api/author/posts/' + encodeURIComponent(slug), {
          method: 'PUT',
          body: JSON.stringify(payload)
        })
        showStatus('已保存 ' + slug)
      }
      await loadPosts()
    } catch (ex) {
      showStatus(ex.message || '保存失败', true)
    }
  })

  refreshSession().catch(() => showLogin())
</script>
