---
import type { GetStaticPaths, Page } from 'astro'
import PageLayout from '@/layouts/BaseLayout.astro'
import type { CollectionEntry } from 'astro:content'

import Pagination from '@/components/blog/Paginator.astro'
import PostPreview from '@/components/blog/PostPreview.astro'
import { Button } from '@/components/user'
import { getAllCollections, getUniqueTags, sortMDByDate } from '@/utils'
import { siteConfig } from '@/site-config'

export const prerender = true

export const getStaticPaths = (async ({ paginate }) => {
  const allPosts = await getAllCollections()
  const allPostsByDate = sortMDByDate(allPosts)
  const uniqueTags = getUniqueTags(allPosts)
  const totalPosts = allPosts.length
  return paginate(allPostsByDate, {
    pageSize: siteConfig.blog.pageSize,
    props: { uniqueTags, totalPosts }
  })
}) satisfies GetStaticPaths

interface Props {
  page: Page<CollectionEntry<'post'>>
  uniqueTags: string[]
  totalPosts: number
}

const { page, uniqueTags, totalPosts } = Astro.props

const meta = {
  description: '我的博客文章与归档',
  title: '文章'
}

const pageShowingZh = `第 ${page.currentPage} 页 · 显示 ${page.data.length} / ${totalPosts} 篇`
const pageShowingEn = `Page ${page.currentPage} · Showing ${page.data.length} of ${totalPosts} posts`

const paginationProps = {
  ...(page.url.prev && {
    prevUrl: {
      text: `← 上一页`,
      textEn: `← Previous Posts`,
      url: page.url.prev
    }
  }),
  ...(page.url.next && {
    nextUrl: {
      text: `下一页 →`,
      textEn: `Next Posts →`,
      url: page.url.next
    }
  })
}
---

<PageLayout {meta}>
  <div class='w-full'>
    <Button title='返回' data-i18n='common.back' href='/' style='back' />
    <h1 class='mb-6 mt-6 text-3xl font-medium sm:mt-10' data-i18n='blog.title'>文章</h1>

    {
      page.data.length === 0 ? (
        <p data-i18n='blog.empty'>还没有文章。</p>
      ) : (
        <>
          <div class='grid gap-y-16 sm:grid-cols-[3fr_1fr] sm:gap-x-8'>
            <section aria-label='文章列表' data-i18n-aria='blog.listAria'>
              <div class='animate mb-3 flex flex-col justify-between text-sm sm:mb-5 sm:flex-row'>
                <span
                  class='text-muted-foreground'
                  data-i18n-zh={pageShowingZh}
                  data-i18n-en={pageShowingEn}
                >
                  {pageShowingZh}
                </span>
                <a
                  aria-label='按年份查看全部文章'
                  data-i18n-aria='blog.archivesAria'
                  href='/archives'
                  data-astro-prefetch
                  data-i18n='blog.archivesLink'
                >
                  按年份查看全部 →
                </a>
              </div>
              <ul class='animate flex flex-col gap-y-4 text-start'>
                {page.data.map((p) => (
                  <PostPreview post={p} detailed />
                ))}
              </ul>
              <Pagination {...paginationProps} />
            </section>
            {!!uniqueTags.length && (
              <aside class='animate' id='sidebar'>
                <h2 class='mb-4 flex items-center text-lg font-semibold'>
                  <svg class='me-2 size-6'>
                    <use href='/icons/ui.svg#mingcute-tag-2-line' />
                  </svg>
                  <span data-i18n='blog.tags'>标签</span>
                </h2>
                <ul class='text-bgColor flex flex-wrap gap-2'>
                  {uniqueTags.map((tag) => (
                    <li>
                      <Button title={tag} href={`/tags/${tag}`} style='pill' />
                    </li>
                  ))}
                </ul>
                <span class='mt-4 block sm:text-end'>
                  <a
                    aria-label='查看全部标签'
                    data-i18n-aria='blog.viewAllTagsAria'
                    href='/tags'
                    data-astro-prefetch
                    data-i18n='blog.viewAllTags'
                  >
                    查看全部 →
                  </a>
                </span>
              </aside>
            )}
          </div>
        </>
      )
    }
  </div>
</PageLayout>
