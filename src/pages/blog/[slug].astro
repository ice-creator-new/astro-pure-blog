---
import PostLayout from '@/layouts/BlogPost.astro'
import { type CollectionEntry } from 'astro:content'

import { getAllCollections, tagHeadingsByLang } from '@/utils'

export const prerender = true

export async function getStaticPaths() {
  const posts = await getAllCollections()
  return posts.map((post: CollectionEntry<'post'>) => ({
    params: { slug: post.slug },
    props: post
  }))
}
type Props = CollectionEntry<'post'>

const post = Astro.props
const { Content, headings: allHeadings } = await post.render()
// Bilingual posts: keep TOC but tag headings so only the active language shows.
const headings = tagHeadingsByLang(post.body ?? '', allHeadings)
---

<PostLayout post={post} {headings}>
  <Content />
</PostLayout>
