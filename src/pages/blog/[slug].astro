---
import PostLayout from '@/layouts/BlogPost.astro'
import { type CollectionEntry } from 'astro:content'

import { getAllCollections } from '@/utils'

export const prerender = true

export async function getStaticPaths() {
  const posts = await getAllCollections()
  return posts.map((post: CollectionEntry<'post'>) => ({
    params: { slug: post.slug },
    props: post
  }))
}
type Props = CollectionEntry<'post'>

const post = Astro.props
const { Content, headings: allHeadings } = await post.render()
// Bilingual posts ship both zh/en bodies; TOC would duplicate — hide it.
const headings = post.data.titleEn ? [] : allHeadings
---

<PostLayout post={post} {headings}>
  <Content />
</PostLayout>
