---
import { cn } from '@/utils'

const { class: className, title, ...rest } = Astro.props
const i18nKey = rest['data-i18n-title']
delete rest['data-i18n-title']
---

<section class={cn('animate flex flex-col gap-y-5 md:flex-row md:gap-y-0', className)} {...rest}>
  <div class='text-xl font-semibold md:min-w-36'>
    <h2 data-i18n={i18nKey}>{title}</h2>
  </div>
  <div class='flex flex-1 flex-col gap-y-3'>
    <slot />
  </div>
</section>
