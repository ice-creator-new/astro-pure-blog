---
import { messages } from '../../i18n/messages'
---

<style is:global>
  html[data-locale='en'] [data-post-lang='zh'] {
    display: none !important;
  }
  html[data-locale='zh'] [data-post-lang='en'],
  html:not([data-locale]) [data-post-lang='en'] {
    display: none !important;
  }
</style>

<script is:inline define:vars={{ messages }}>
  ;(function () {
    const STORAGE_KEY = 'ice-blog-lang'
    const dict = messages
    window.__iceMessages = messages

    function detectLocale() {
      try {
        const saved = localStorage.getItem(STORAGE_KEY)
        if (saved === 'zh' || saved === 'en') return saved
      } catch (_) {}
      const nav =
        (typeof navigator !== 'undefined' &&
          (navigator.language || (navigator.languages && navigator.languages[0]))) ||
        'zh'
      return String(nav).toLowerCase().startsWith('zh') ? 'zh' : 'en'
    }

    function applyLocale(locale) {
      const table = dict[locale] || dict.zh
      document.documentElement.lang = locale === 'zh' ? 'zh-CN' : 'en'
      document.documentElement.dataset.locale = locale

      document.querySelectorAll('[data-i18n]').forEach((el) => {
        const key = el.getAttribute('data-i18n')
        if (!key || table[key] == null) return
        const attr = el.getAttribute('data-i18n-attr')
        if (attr) {
          el.setAttribute(attr, table[key])
        } else {
          el.textContent = table[key]
        }
      })

      document.querySelectorAll('[data-i18n-title]').forEach((el) => {
        const key = el.getAttribute('data-i18n-title')
        if (key && table[key] != null) el.setAttribute('title', table[key])
      })

      document.querySelectorAll('[data-i18n-aria]').forEach((el) => {
        const key = el.getAttribute('data-i18n-aria')
        if (key && table[key] != null) el.setAttribute('aria-label', table[key])
      })

      // Dual-language text nodes (article title / description / list cards)
      document.querySelectorAll('[data-i18n-zh]').forEach((el) => {
        const zh = el.getAttribute('data-i18n-zh')
        const en = el.getAttribute('data-i18n-en')
        if (zh == null) return
        el.textContent = locale === 'en' && en != null ? en : zh
      })

      // Article body language blocks
      document.querySelectorAll('[data-post-lang]').forEach((el) => {
        const lang = el.getAttribute('data-post-lang')
        const show = lang === locale
        el.hidden = !show
        el.setAttribute('aria-hidden', show ? 'false' : 'true')
      })

      const btn = document.getElementById('toggleLang')
      if (btn) {
        const label = btn.querySelector('[data-lang-label]')
        if (label) label.textContent = locale === 'zh' ? 'EN' : '中文'
        btn.setAttribute('aria-label', table['nav.lang'] || 'Language')
        btn.setAttribute('title', table['nav.lang'] || 'Language')
      }

      try {
        localStorage.setItem(STORAGE_KEY, locale)
      } catch (_) {}

      window.dispatchEvent(new CustomEvent('ice-locale-change', { detail: { locale } }))
    }

    const locale = detectLocale()
    applyLocale(locale)
    window.__iceApplyLocale = applyLocale
    window.__iceGetLocale = () => document.documentElement.dataset.locale || locale

    document.addEventListener('DOMContentLoaded', () => {
      applyLocale(window.__iceGetLocale())
      const btn = document.getElementById('toggleLang')
      if (btn && !btn.dataset.bound) {
        btn.dataset.bound = '1'
        btn.addEventListener('click', () => {
          const cur = window.__iceGetLocale()
          applyLocale(cur === 'zh' ? 'en' : 'zh')
        })
      }
    })
  })()
</script>
